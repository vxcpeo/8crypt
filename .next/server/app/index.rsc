35:["$","section",null,{"aria-labelledby":"faq-title","className":"gx-band","id":"risks","children":[["$","div",null,{"className":"gx-bandhead","children":[["$","p",null,{"className":"gx-kicker","children":"Before you swap"}],["$","span",null,{"className":"gx-bandnum","aria-hidden":"true"}],["$","span",null,{"className":"gx-rule","aria-hidden":"true"}],["$","h2",null,{"className":"gx-h2","id":"faq-title","children":["Questions, ",["$","em",null,{"children":"answered straight."}]]}]]}],["$","p",null,{"className":"gx-copy","children":"What can go wrong, who controls what, and where every fee goes."}],["$","div",null,{"className":"gx-faq","children":[["$","details","Where does the money for the $GEMMORA buyback come from?",{"className":"gx-faq-item","open":true,"children":[["$","summary",null,{"children":["Where does the money for the $GEMMORA buyback come from?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"children":"Only from swap fees: 1 USDC per side on each completed swap. There are no emissions and no outside top-ups. If nobody swaps, nothing is bought. Cancelled and expired offers pay nothing."}]]}],["$","details","Who can change the rules after launch?",{"className":"gx-faq-item","open":false,"children":[["$","summary",null,{"children":["Who can change the rules after launch?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"children":"An admin key sets the fee, the treasury account and the $GEMMORA waiver, and can pause new offers. The program caps the fee at 10 USDC per side, and an open offer keeps the fee it was made with. The admin key cannot move escrowed cards or USDC, and a pause never blocks cancel or accept."}]]}],["$","details","Do I need to claim anything?",{"className":"gx-faq-item","open":false,"children":[["$","summary",null,{"children":["Do I need to claim anything?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"children":"No. On accept, both cards and the USDC land in the two wallets in the same transaction. On cancel or expiry, the card, the USDC and the held fee go straight back to the bidder."}]]}],["$","details","What can go wrong?",{"className":"gx-faq-item","open":false,"children":[["$","summary",null,{"children":["What can go wrong?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"children":"The program is not audited: a bug could lock or lose escrowed cards or USDC. Card values shown are Collector Crypt’s insured value, an estimate, not a price anyone will pay. An accepted swap is final. Collector Crypt is a third party and could change its collection or transfer rules, which could block new offers. $GEMMORA can lose all its value."}]]}],["$","details","Is there a presale, team allocation or airdrop?",{"className":"gx-faq-item","open":false,"children":[["$","summary",null,{"children":["Is there a presale, team allocation or airdrop?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"children":"No presale, no team allocation, no airdrop. $GEMMORA launches on Pump.fun with the standard 1,000,000,000 supply. The dev buy at launch will be disclosed with its transaction."}]]}],["$","details","Is it audited?",{"className":"gx-faq-item","open":false,"children":[["$","summary",null,{"children":["Is it audited?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"children":"No. The program has 20 tests (13 of them attacks that must be refused) run in LiteSVM against the real mainnet Token Metadata and Token Auth Rules programs, Collector Crypt’s rule set and two real Collector Crypt cards. That is testing, not an audit. Start with cards you can afford to have stuck."}]]}],["$","details","Can I swap a card listed on a marketplace?",{"className":"gx-faq-item","open":false,"children":[["$","summary",null,{"children":["Can I swap a card listed on a marketplace?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","div",null,{"children":"Not while it is listed. A listing locks the card, so the escrow cannot take it. Delist it first, then make or accept the offer."}]]}],"$L40","$L41"]}]]}]
