10:["$","section",null,{"id":"how","children":[["$","h2",null,{"children":"How it works"}],["$","ol",null,{"className":"tx-doc-steps","children":[["$","li",null,{"children":[["$","b",null,{"children":"Make an offer."}]," Pick the card you want, choose one of your cards to give, and set the USDC: added by you, asked from the owner, or none. Optionally set an expiry. You sign one transaction; your card, your USDC and your 1 USDC fee go into escrow accounts owned by the offer."]}],["$","li",null,{"children":[["$","b",null,{"children":"The owner answers."}]," They see the offer with both insured values side by side. They can accept, ignore it, or counter with a new offer the other way."]}],["$","li",null,{"children":[["$","b",null,{"children":"Accept settles everything."}]," The owner signs one transaction. Both cards and the USDC move in the same instruction, or nothing moves."]}],["$","li",null,{"children":[["$","b",null,{"children":"Cancel or expiry."}]," Until it is accepted, the bidder can cancel for free. After an expiry, anyone can send the escrow back to the bidder."]}]]}],["$","h3",null,{"children":"Worked example"}],["$","p",null,{"className":"tx-doc-note","children":"Example names and values."}],["$","div",null,{"className":"tx-table-wrap","children":["$","table",null,{"className":"tx-table","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Step"}],["$","th",null,{"children":"Maya (bidder)"}],["$","th",null,{"children":"Leo (owner)"}],["$","th",null,{"children":"Treasury"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Start"}],["$","td",null,{"children":"Blastoise Holo PSA 8 ($380 est.), 100 USDC"}],["$","td",null,{"children":"Charizard ex PSA 9 ($420 est.), 0 USDC"}],["$","td",null,{"children":"0"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"make_offer (+40 USDC)"}],["$","td",null,{"children":"Card, 40 USDC and 1 USDC fee in escrow. Wallet: 59 USDC"}],["$","td",null,{"children":"No change"}],["$","td",null,{"children":"0"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"accept"}],["$","td",null,{"children":"Receives Charizard ex. Wallet: 59 USDC"}],["$","td",null,{"children":"Receives Blastoise + 40 USDC, minus 1 USDC fee = 39 USDC"}],["$","td",null,{"children":"+2 USDC"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"If Maya cancels instead"}],["$","td",null,{"children":"Gets back Blastoise and 41 USDC. Wallet: 100 USDC"}],["$","td",null,{"children":"No change"}],["$","td",null,{"children":"0"}]]}]]}]]}]}],["$","p",null,{"children":"Each side also pays the Solana network fee for the transaction it signs. The rent for the offer accounts is a deposit paid by the bidder and returned when the offer closes."}]]}]
11:["$","section",null,{"id":"fees","children":[["$","h2",null,{"children":"Fees"}],["$","p",null,{"children":"1 USDC per side, only on a completed swap. Nothing on cancel or expiry. The fee in force is written into each offer when it is made, so a later change never reprices an open offer. The program caps it at 10 USDC per side."}],["$","div",null,{"className":"tx-table-wrap","children":["$","table",null,{"className":"tx-table","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Who pays"}],["$","th",null,{"children":"When"}],["$","th",null,{"children":"Amount"}],["$","th",null,{"children":"Where it goes"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Bidder (maker)"}],["$","td",null,{"children":"Held in the offer when it is made; charged only if the swap completes, returned on cancel or expiry"}],["$","td",null,{"className":"tx-num","children":"1 USDC"}],["$","td",null,{"children":"Treasury USDC account (set at deploy)"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Card owner (taker)"}],["$","td",null,{"children":"On accept, taken first from the USDC the bidder added, the rest from the owner's wallet"}],["$","td",null,{"className":"tx-num","children":"1 USDC"}],["$","td",null,{"children":"Treasury USDC account (set at deploy)"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Any side holding ≥ 1,000,000 $GRADIX"}],["$","td",null,{"children":"Bidder checked at make, owner checked at accept"}],["$","td",null,{"className":"tx-num","children":"0 USDC"}],["$","td",null,{"children":"—"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Treasury"}],["$","td",null,{"children":"Once a day"}],["$","td",null,{"className":"tx-num","children":"100% of swap fees"}],["$","td",null,{"children":"Market buy of $GRADIX, then burned (buyback wallet set at deploy)"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"$$GRADIX traders on Pump.fun"}],["$","td",null,{"children":"On every $GRADIX trade, at Pump.fun's creator-fee rate"}],["$","td",null,{"className":"tx-num","children":"Pump.fun rate"}],["$","td",null,{"children":"Project wallet, for development (set at deploy)"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Everyone"}],["$","td",null,{"children":"Each transaction"}],["$","td",null,{"className":"tx-num","children":"Solana network fee"}],["$","td",null,{"children":"Validators. Account rent is a deposit, returned to the bidder when the offer closes"}]]}]]}]]}]}],["$","p",null,{"children":"The 2% Collector Crypt royalty does not apply: a swap is two transfers, not a sale. Collector Crypt's transfer rule set still runs on every card move."}]]}]
